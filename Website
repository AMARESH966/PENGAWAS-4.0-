        ['#0369a1', '#e879f9'], ['#1e40af', '#f472b6'], ['#6d28d9', '#f43f5e']
      ];

      for (let i = 2; i <= 100; i++) {
        const angle = (i * 37) % 360;
        const pal = palettes[i % palettes.length];
        if (i % 5 === 0) {
          bgs.push({
            id: i,
            name: `Aurora Glow #${i}`,
            css: `radial-gradient(circle at ${(i * 19) % 100}% ${(i * 29) % 100}%, ${pal[1]}, ${pal[0]} 65%, #0f172a 100%)`
          });
        } else if (i % 4 === 0) {
          const hue1 = (i * 23) % 360;
          const hue2 = (hue1 + 110) % 360;
          bgs.push({
            id: i,
            name: `Pastel Harmony #${i}`,
            css: `linear-gradient(${angle}deg, hsl(${hue1}, 85%, 72%) 0%, hsl(${hue2}, 85%, 75%) 100%)`
          });
        } else {
          const hueA = (200 + (i * 17)) % 360;
          const hueB = (320 + (i * 13)) % 360;
          bgs.push({
            id: i,
            name: `Studio Theme #${i}`,
            css: `linear-gradient(${angle}deg, hsl(${hueA}, 78%, 48%) 0%, hsl(${(hueA + hueB) / 2}, 75%, 52%) 50%, hsl(${hueB}, 82%, 55%) 100%)`
          });
        }
      }
      return bgs;
    }

