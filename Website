    function renderChartsData() {
      const metrics = appState.classMetrics || buildDefaultState().classMetrics;

      let totalCases = 0, totalHabits = 0, totalDuties = 0;
      CLASSES_LIST.forEach(cls => {
        totalCases += metrics[cls].cases;
        totalHabits += metrics[cls].habits;
        totalDuties += metrics[cls].duties;
      });

      document.getElementById('stat-cases-total').textContent = totalCases;
      document.getElementById('stat-habits-total').textContent = totalHabits;
      document.getElementById('stat-duties-total').textContent = totalDuties;

      // Cases Bars
      const maxCases = Math.max(10, ...CLASSES_LIST.map(c => metrics[c].cases));
      const casesContainer = document.getElementById('chart-cases-bars');
      if (casesContainer) {
        casesContainer.innerHTML = CLASSES_LIST.map(cls => {
          const val = metrics[cls].cases;
          const pct = Math.min(100, (val / maxCases) * 100);
          return `
            <div>
              <div class="flex justify-between text-xs font-bold text-slate-700 mb-1">
                <span>${escapeHtml(cls)}</span>
                <span class="text-rose-600">${val} Kes</span>
              </div>
              <div class="w-full h-3 bg-slate-200 rounded-full overflow-hidden">
                <div class="h-full bg-gradient-to-r from-rose-500 to-pink-500 rounded-full transition-all duration-500" style="width: ${pct}%"></div>
              </div>
            </div>
          `;
        }).join('');
      }

      // Habits Bars
      const maxHabits = Math.max(50, ...CLASSES_LIST.map(c => metrics[c].habits));
      const habitsContainer = document.getElementById('chart-habits-bars');
      if (habitsContainer) {
        habitsContainer.innerHTML = CLASSES_LIST.map(cls => {
          const val = metrics[cls].habits;
          const pct = Math.min(100, (val / maxHabits) * 100);
          return `
            <div>
              <div class="flex justify-between text-xs font-bold text-slate-700 mb-1">
                <span>${escapeHtml(cls)}</span>
                <span class="text-emerald-700">${val} Amalan</span>
              </div>
              <div class="w-full h-3 bg-slate-200 rounded-full overflow-hidden">
                <div class="h-full bg-gradient-to-r from-emerald-500 to-teal-500 rounded-full transition-all duration-500" style="width: ${pct}%"></div>
              </div>
            </div>
          `;
        }).join('');
      }

      // Duties Bars
      const maxDuties = Math.max(80, ...CLASSES_LIST.map(c => metrics[c].duties));
      const dutiesContainer = document.getElementById('chart-duties-bars');
      if (dutiesContainer) {
        dutiesContainer.innerHTML = CLASSES_LIST.map(cls => {
          const val = metrics[cls].duties;
          const pct = Math.min(100, (val / maxDuties) * 100);
          return `
            <div>
              <div class="flex justify-between text-xs font-bold text-slate-700 mb-1">
                <span>${escapeHtml(cls)}</span>
                <span class="text-blue-700">${val} Tugas</span>
              </div>
              <div class="w-full h-3 bg-slate-200 rounded-full overflow-hidden">
                <div class="h-full bg-gradient-to-r from-blue-600 to-indigo-500 rounded-full transition-all duration-500" style="width: ${pct}%"></div>
              </div>
            </div>
          `;
        }).join('');
      }
    }

