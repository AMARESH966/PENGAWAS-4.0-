        id: 1,
        name: 'Classic Blue & Pink',
        css: 'linear-gradient(135deg, #1d4ed8 0%, #3b82f6 35%, #ec4899 75%, #f43f5e 100%)'
      });

      const palettes = [
        ['#2563eb', '#db2777'], ['#1e3a8a', '#be185d'], ['#0284c7', '#f43f5e'],
        ['#4f46e5', '#ec4899'], ['#0f172a', '#2563eb', '#ec4899'], ['#3b82f6', '#a855f7', '#ec4899'],
