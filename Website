<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>PENGAWAS 3.0 — Sistem Pengurusan Pengawas Sekolah</title>
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Tone.js for Startup "Go Beyond" Traditional Ringtone -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/tone/14.8.49/Tone.js"></script>
  <!-- Tamil & Classic Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Anek+Tamil:wght@400;600;700&family=Baloo+Thambi+2:wght@400;600;700&family=Catamaran:wght@400;600;700&family=Cinzel:wght@600;700&family=Kavivanar&family=Meera+Inimai&family=Noto+Sans+Tamil:wght@400;600;700&family=Playfair+Display:wght@600;700&family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
  <!-- Dynamic Google Font Link Target for 4.0 Pro -->
  <link id="dynamic-google-font" rel="stylesheet" href="">

  <style>
    :root {
      --app-font: 'Comic Sans MS', 'Comic Sans', cursive;
      --bg-style: linear-gradient(135deg, #1d4ed8 0%, #3b82f6 35%, #ec4899 75%, #f43f5e 100%);
    }

    body {
      font-family: var(--app-font);
      background: var(--bg-style);
      background-attachment: fixed;
      background-size: cover;
      min-height: 100vh;
      transition: background 0.4s ease, font-family 0.2s ease;
    }

    /* 4.0 Taskbar Glasses 100 & Glassmorphism Surfaces */
    .glass-panel {
      background: rgba(255, 255, 255, 0.92);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border: 1px solid rgba(255, 255, 255, 0.75);
      box-shadow: 0 25px 50px -12px rgba(15, 23, 42, 0.32);
    }

    .glass-subpanel {
      background: rgba(255, 255, 255, 0.78);
      backdrop-filter: blur(12px);
      border: 1px solid rgba(255, 255, 255, 0.65);
    }

    /* Theme Accents */
    .theme-dual .btn-primary {
      background: linear-gradient(135deg, #2563eb 0%, #db2777 100%);
      color: #ffffff;
    }
    .theme-dual .btn-primary:hover {
      background: linear-gradient(135deg, #1d4ed8 0%, #be185d 100%);
    }
    .theme-dual .badge-accent {
      background: linear-gradient(135deg, #dbeafe 0%, #fce7f3 100%);
      color: #1e3a8a;
      border: 1px solid #f9a8d4;
    }

    .theme-blue .btn-primary {
      background: linear-gradient(135deg, #1e40af 0%, #3b82f6 100%);
      color: #ffffff;
    }
    .theme-blue .btn-primary:hover {
      background: linear-gradient(135deg, #1e3a8a 0%, #2563eb 100%);
    }
    .theme-blue .badge-accent {
      background: #dbeafe;
      color: #1e40af;
      border: 1px solid #93c5fd;
    }

    .theme-pink .btn-primary {
      background: linear-gradient(135deg, #be185d 0%, #f43f5e 100%);
      color: #ffffff;
    }
    .theme-pink .btn-primary:hover {
      background: linear-gradient(135deg, #9d174d 0%, #e11d48 100%);
    }
    .theme-pink .badge-accent {
      background: #fce7f3;
      color: #9d174d;
      border: 1px solid #f9a8d4;
    }

    /* Custom Scrollbar */
    ::-webkit-scrollbar {
      width: 8px;
      height: 8px;
    }
    ::-webkit-scrollbar-track {
      background: rgba(255, 255, 255, 0.3);
      border-radius: 9999px;
    }
    ::-webkit-scrollbar-thumb {
      background: rgba(37, 99, 235, 0.45);
      border-radius: 9999px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: rgba(219, 39, 119, 0.65);
    }

    /* Animation 100 Smooth Keyframes */
    @keyframes fadeInScale {
      from {
        opacity: 0;
        transform: translateY(10px) scale(0.98);
      }
      to {
        opacity: 1;
        transform: translateY(0) scale(1);
      }
    }
    .animate-fade-in {
      animation: fadeInScale 0.28s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    /* Print Styles for File Export */
    @media print {
      body {
        background: #ffffff !important;
      }
      .no-print {
        display: none !important;
      }
      .print-only {
        display: block !important;
      }
    }
  </style>
</head>
<body class="theme-dual text-slate-800 antialiased selection:bg-pink-200 selection:text-blue-900">

  <!-- Toast Notification Container -->
  <div id="toast-container" class="fixed top-4 right-4 z-50 flex flex-col gap-2 max-w-sm w-full pointer-events-none px-4 sm:px-0"></div>

  <!-- =====================================================================
       1. STARTUP / LOGIN SCREEN (PENGAWAS 3.0 / 4.0 PRO)
       ===================================================================== -->
  <div id="login-screen" class="min-h-screen flex items-center justify-center p-4 sm:p-6">
    <div class="glass-panel rounded-3xl w-full max-w-lg p-6 sm:p-9 animate-fade-in relative overflow-hidden">
      <!-- Top Decorative Ribbon -->
      <div class="absolute top-0 left-0 right-0 h-2 bg-gradient-to-r from-blue-600 via-indigo-500 to-pink-500"></div>

      <!-- Theme Switcher Mini Pill -->
      <div class="flex items-center gap-1.5 mb-6">
        <span id="login-version-badge" class="px-3 py-1 rounded-full text-xs font-bold tracking-wider uppercase badge-accent shadow-sm">
          SYSTEM v3.0 CLASSIC
        </span>
        <div class="flex items-center gap-1.5 ml-auto">
          <!-- Startup Music "Go Beyond" Traditional Ringtone Controls -->
          <button type="button" onclick="playGoBeyondRingtone(true)" title="Mainkan Ringtone Go Beyond"
            class="px-2.5 py-1 rounded-full bg-white/90 hover:bg-blue-50 text-blue-700 border border-blue-200 text-xs font-bold shadow-sm flex items-center gap-1 transition cursor-pointer">
            <span>🔔</span>
            <span class="hidden sm:inline">Go Beyond</span>
          </button>
          <button type="button" id="btn-toggle-startup-sound" onclick="toggleStartupSound()" title="Mute / Unmute Startup Music"
            class="w-7 h-7 rounded-full bg-white/90 hover:bg-pink-50 text-pink-600 border border-pink-200 text-xs font-bold shadow-sm flex items-center justify-center transition cursor-pointer">
            🔊
          </button>
          <div class="flex items-center gap-1.5 bg-white/80 p-1 rounded-full border border-slate-200 shadow-sm">
            <button type="button" onclick="setColorTheme('dual')" title="Classic Blue & Pink" class="w-5 h-5 rounded-full bg-gradient-to-tr from-blue-600 to-pink-500 ring-2 ring-offset-1 ring-transparent hover:scale-110 transition"></button>
            <button type="button" onclick="setColorTheme('blue')" title="Royal Blue Mode" class="w-5 h-5 rounded-full bg-blue-600 hover:scale-110 transition"></button>
            <button type="button" onclick="setColorTheme('pink')" title="Rose Pink Mode" class="w-5 h-5 rounded-full bg-pink-500 hover:scale-110 transition"></button>
          </div>
        </div>
      </div>

      <!-- Emblem & Title -->
      <div class="text-center mb-7">
        <div class="mx-auto w-20 h-20 rounded-2xl bg-gradient-to-br from-blue-600 to-pink-500 p-0.5 shadow-lg mb-4">
          <div class="w-full h-full bg-white rounded-2xl flex items-center justify-center">
            <!-- School Shield SVG -->
            <svg class="w-11 h-11 text-blue-700" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" fill="url(#shieldGrad)" stroke="#1d4ed8"/>
              <path d="M9 12l2 2 4-4" stroke="#ffffff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
              <defs>
                <linearGradient id="shieldGrad" x1="4" y1="2" x2="20" y2="22" gradientUnits="userSpaceOnUse">
                  <stop stop-color="#2563eb"/>
                  <stop offset="1" stop-color="#ec4899"/>
                </linearGradient>
              </defs>
            </svg>
          </div>
        </div>
        <h1 id="login-main-title" class="text-3xl sm:text-4xl font-extrabold tracking-tight bg-gradient-to-r from-blue-700 via-indigo-700 to-pink-600 bg-clip-text text-transparent">
          PENGAWAS 3.0
        </h1>
        <p id="login-subtitle" class="text-sm text-slate-600 mt-1">
          Portal Rasmi Badan Pengawas Sekolah • Tahun 6
        </p>
      </div>

      <!-- Login Form -->
      <form id="login-form" onsubmit="handleLogin(event)" class="space-y-4">
        <div>
          <label for="login-username" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1" data-i18n="username">
            Username
          </label>
          <input id="login-username" type="text" required placeholder="Contoh: Kavinesh / Aisyah"
            class="w-full px-4 py-3 rounded-xl bg-white/90 border border-slate-300 focus:border-blue-500 focus:ring-2 focus:ring-pink-300 outline-none transition text-slate-800" />
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label for="login-pengawas-no" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1" data-i18n="pengawasNombor">
              Pengawas Nombor
            </label>
            <input id="login-pengawas-no" type="text" required placeholder="Contoh: PGW-001"
              class="w-full px-4 py-3 rounded-xl bg-white/90 border border-slate-300 focus:border-blue-500 focus:ring-2 focus:ring-pink-300 outline-none transition text-slate-800 uppercase" />
          </div>

          <div>
            <label for="login-kelas" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1" data-i18n="kelas">
              Kelas
            </label>
            <select id="login-kelas" required
              class="w-full px-4 py-3 rounded-xl bg-white/90 border border-slate-300 focus:border-blue-500 focus:ring-2 focus:ring-pink-300 outline-none transition text-slate-800">
              <option value="6 Thamarai">6 Thamarai</option>
              <option value="6 Samanthi">6 Samanthi</option>
              <option value="6 Maliagai">6 Maliagai</option>
              <option value="6 Kuringi">6 Kuringi</option>
              <option value="6 Alli">6 Alli</option>
              <option value="Ketua Pengawas">Ketua Pengawas (Lembaga)</option>
            </select>
          </div>
        </div>

        <div>
          <div class="flex items-center justify-between mb-1">
            <label for="login-password" class="block text-xs font-bold uppercase tracking-wider text-slate-700" data-i18n="password">
              Password
            </label>
            <span class="text-[11px] text-slate-500" id="password-hint-label">Default: 1234</span>
          </div>
          <input id="login-password" type="password" required placeholder="Masukkan kata laluan..."
            class="w-full px-4 py-3 rounded-xl bg-white/90 border border-slate-300 focus:border-blue-500 focus:ring-2 focus:ring-pink-300 outline-none transition text-slate-800" />
        </div>

        <div class="pt-2 flex flex-col sm:flex-row gap-3">
          <button type="submit" class="btn-primary flex-1 py-3.5 px-6 rounded-xl font-bold shadow-lg hover:shadow-xl transform active:scale-[0.99] transition flex items-center justify-center gap-2 cursor-pointer">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"/>
            </svg>
            <span data-i18n="signIn">Sign In</span>
          </button>

          <button type="button" onclick="quickDemoFill()" class="py-3.5 px-4 rounded-xl font-semibold bg-white/90 hover:bg-white text-blue-700 border border-blue-200 shadow-sm transition text-sm cursor-pointer">
            ⚡ Quick Demo Fill
          </button>
        </div>
      </form>

      <!-- Language Bar on Login -->
      <div class="mt-6 pt-4 border-t border-slate-200/80 flex flex-wrap items-center justify-between gap-2 text-xs">
        <span class="text-slate-500 font-semibold">Bahasa / Font:</span>
        <div class="flex gap-1.5">
          <button type="button" onclick="setLanguage('ms')" class="px-2.5 py-1 rounded-lg bg-blue-50 hover:bg-blue-100 text-blue-800 font-semibold border border-blue-200 transition">Melayu</button>
          <button type="button" onclick="setLanguage('en')" class="px-2.5 py-1 rounded-lg bg-pink-50 hover:bg-pink-100 text-pink-800 font-semibold border border-pink-200 transition">English</button>
          <button type="button" onclick="setLanguage('ta')" class="px-2.5 py-1 rounded-lg bg-indigo-50 hover:bg-indigo-100 text-indigo-800 font-semibold border border-indigo-200 transition">தமிழ்</button>
        </div>
      </div>
    </div>
  </div>

  <!-- =====================================================================
       2. MAIN APPLICATION SHELL (DASHBOARD + SETTINGS APP)
       ===================================================================== -->
  <div id="main-app" class="hidden min-h-screen flex flex-col">

    <!-- Top Navigation Bar -->
    <header class="sticky top-0 z-30 glass-panel border-b border-white/60 px-4 sm:px-8 py-3 no-print">
      <div class="max-w-7xl mx-auto flex flex-wrap items-center justify-between gap-3">
        <!-- Brand & Edition Badge -->
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-blue-600 to-pink-500 flex items-center justify-center text-white font-extrabold shadow-md">
            P
          </div>
          <div>
            <div class="flex items-center gap-2">
              <h1 id="nav-app-title" class="text-lg sm:text-xl font-extrabold bg-gradient-to-r from-blue-700 to-pink-600 bg-clip-text text-transparent">
                PENGAWAS 3.0
              </h1>
              <span id="nav-pro-badge" class="hidden px-2 py-0.5 text-[10px] font-extrabold uppercase tracking-wider rounded-full bg-gradient-to-r from-amber-400 to-pink-500 text-white shadow-sm">
                4.0 PRO
              </span>
            </div>
            <p class="text-xs text-slate-600" id="nav-user-summary">Selamat Datang</p>
          </div>
        </div>

        <!-- Primary App Switcher & Theme Controls -->
        <div class="flex items-center gap-2 sm:gap-3">
          <button type="button" onclick="switchMainView('dashboard')" id="nav-btn-dashboard"
            class="px-3.5 py-2 rounded-xl text-xs sm:text-sm font-bold transition flex items-center gap-1.5 bg-blue-600 text-white shadow-md cursor-pointer">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
            </svg>
            <span data-i18n="dashboard">Dashboard</span>
          </button>

          <!-- Dedicated "Settings" App Button -->
          <button type="button" onclick="switchMainView('settings')" id="nav-btn-settings"
            class="px-3.5 py-2 rounded-xl text-xs sm:text-sm font-bold transition flex items-center gap-1.5 bg-white/90 hover:bg-pink-50 text-slate-800 border border-pink-200 shadow-sm cursor-pointer">
            <svg class="w-4 h-4 text-pink-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
            <span data-i18n="settings">Settings</span>
          </button>

          <!-- Color Theme Mini Toggle -->
          <div class="hidden md:flex items-center gap-1 bg-white/80 p-1 rounded-full border border-slate-200">
            <button type="button" onclick="setColorTheme('dual')" title="Classic Blue & Pink" class="w-5 h-5 rounded-full bg-gradient-to-tr from-blue-600 to-pink-500"></button>
            <button type="button" onclick="setColorTheme('blue')" title="Blue Theme" class="w-5 h-5 rounded-full bg-blue-600"></button>
            <button type="button" onclick="setColorTheme('pink')" title="Pink Theme" class="w-5 h-5 rounded-full bg-pink-500"></button>
          </div>

          <button type="button" onclick="handleLogout()" title="Sign Out"
            class="p-2 rounded-xl bg-rose-50 hover:bg-rose-100 text-rose-600 border border-rose-200 transition cursor-pointer">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
            </svg>
          </button>
        </div>
      </div>
    </header>

    <!-- ===================================================================
         VIEW A: DASHBOARD VIEW (ALL MANAGEMENT & 4.0 PRO EDITING HERE)
         =================================================================== -->
    <main id="view-dashboard" class="flex-1 max-w-7xl w-full mx-auto p-4 sm:p-8 space-y-6 animate-fade-in">

      <!-- Dashboard Internal Navigation Bar (Overview, Data Murid, 60 Guru + Photo, File & Make File, 4.0 Studio) -->
      <div class="glass-panel rounded-3xl p-3 flex flex-wrap items-center justify-between gap-2 anim-float-100">
        <div class="flex flex-wrap items-center gap-1.5 sm:gap-2" id="dash-subnav">
          <button type="button" onclick="switchDashboardTab('overview')" id="dtab-overview"
            class="px-3.5 py-2 rounded-2xl text-xs sm:text-sm font-extrabold transition btn-primary shadow cursor-pointer">
            🏠 Overview & Profil
          </button>
          <button type="button" onclick="switchDashboardTab('datamurid')" id="dtab-datamurid"
            class="px-3.5 py-2 rounded-2xl text-xs sm:text-sm font-bold transition bg-white/85 hover:bg-blue-50 text-slate-800 border border-slate-200 cursor-pointer">
            🎓 Data Murid (5 Kelas)
          </button>
          <button type="button" onclick="switchDashboardTab('guru')" id="dtab-guru"
            class="px-3.5 py-2 rounded-2xl text-xs sm:text-sm font-bold transition bg-white/85 hover:bg-pink-50 text-slate-800 border border-slate-200 cursor-pointer">
            👩‍🏫 Guru (60) & Foto
          </button>
          <button type="button" onclick="switchDashboardTab('charts')" id="dtab-charts"
            class="px-3.5 py-2 rounded-2xl text-xs sm:text-sm font-bold transition bg-white/85 hover:bg-indigo-50 text-slate-800 border border-slate-200 cursor-pointer">
            📊 Data Chart & Add Cases
          </button>
          <button type="button" onclick="switchDashboardTab('files')" id="dtab-files"
            class="px-3.5 py-2 rounded-2xl text-xs sm:text-sm font-bold transition bg-white/85 hover:bg-blue-50 text-slate-800 border border-slate-200 cursor-pointer">
            📁 File & Make File
          </button>
          <button type="button" onclick="switchDashboardTab('studio')" id="dtab-studio"
            class="px-3.5 py-2 rounded-2xl text-xs sm:text-sm font-bold transition bg-white/85 hover:bg-pink-50 text-slate-800 border border-slate-200 cursor-pointer">
            🎨 4.0 Taskbar Glasses 100
          </button>
        </div>

        <div id="dash-pro-status-pill" class="px-3 py-1.5 rounded-2xl text-xs font-extrabold badge-accent anim-glow-100">
          Mode: PENGAWAS 3.0
        </div>
      </div>

      <!-- =================================================================
           DASHBOARD TAB 1: OVERVIEW, EDIT NAME & KETUA PENGAWAS
           ================================================================= -->
      <div id="dpanel-overview" class="space-y-6 animate-fade-in">
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
          <!-- Logged-in Pengawas Card -->
          <div class="lg:col-span-2 glass-panel rounded-3xl p-6 flex flex-col justify-between relative overflow-hidden">
            <div class="flex flex-wrap items-start justify-between gap-4">
              <div>
                <span class="px-3 py-1 rounded-full text-xs font-bold badge-accent inline-block mb-2">
                  PROFIL BERTUGAS • <span id="dash-badge-no">PGW-101</span>
                </span>
                <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900" id="dash-user-name">Pengawas</h2>
                <p class="text-sm text-slate-600 mt-1">
                  <span data-i18n="kelas">Kelas</span>: <strong class="text-blue-700" id="dash-user-kelas">6 Thamarai</strong> •
                  Status: <span class="text-emerald-600 font-bold">Aktif Bertugas</span>
                </p>
              </div>

              <button type="button" onclick="switchMainView('settings')"
                class="group flex items-center gap-3 bg-gradient-to-r from-blue-600 to-pink-500 text-white px-4 py-3 rounded-2xl shadow-lg hover:shadow-xl transition cursor-pointer">
                <div class="w-9 h-9 rounded-xl bg-white/20 flex items-center justify-center group-hover:rotate-45 transition-transform">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                  </svg>
                </div>
                <div class="text-left">
                  <div class="text-[11px] opacity-90 uppercase font-semibold">Settings App</div>
                  <div class="text-xs sm:text-sm font-extrabold">Bahasa / Password / 4.0</div>
                </div>
              </button>
            </div>

