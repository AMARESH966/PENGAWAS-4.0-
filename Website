    function handleTeacherPhotoUpload(event, teacherId) {
      const file = event.target.files && event.target.files[0];
      if (!file) return;

      const reader = new FileReader();
      reader.onload = function(e) {
        const img = new Image();
        img.onload = function() {
          const canvas = document.createElement('canvas');
          const size = 150;
          canvas.width = size;
          canvas.height = size;
          const ctx = canvas.getContext('2d');
          const minSide = Math.min(img.width, img.height);
          const sx = (img.width - minSide) / 2;
          const sy = (img.height - minSide) / 2;
          ctx.drawImage(img, sx, sy, minSide, minSide, 0, 0, size, size);

          const compressedDataUrl = canvas.toDataURL('image/jpeg', 0.8);
          const teacher = appState.teachers.find(t => t.id === teacherId);
          if (teacher) {
            teacher.photo = compressedDataUrl;
            saveState();
            renderDashboardTeachers();
            showToast(`Profile Photo untuk ${teacher.name} disimpan!`, 'success');
          }
        };
        img.src = e.target.result;
      };
      reader.readAsDataURL(file);
    }

