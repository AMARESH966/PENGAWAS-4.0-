      toast.innerHTML = `
        <span>${escapeHtml(message)}</span>
        <button type="button" onclick="this.parentElement.remove()" class="opacity-80 hover:opacity-100 font-extrabold">✕</button>
      `;

      container.appendChild(toast);
      setTimeout(() => {
        if (toast.parentElement) toast.remove();
      }, 3600);
    }

    function escapeHtml(str) {
      if (str === null || str === undefined) return '';
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }

    function applyVisualSettings() {
      document.body.classList.remove('theme-dual', 'theme-blue', 'theme-pink');
      document.body.classList.add(`theme-${appState.colorTheme || 'dual'}`);

      const bgObj = BACKGROUNDS_100.find(b => b.id === appState.backgroundId) || BACKGROUNDS_100[0];
      document.documentElement.style.setProperty('--bg-style', bgObj.css);
      const activeBgLabel = document.getElementById('active-bg-label');
      if (activeBgLabel) {
        activeBgLabel.textContent = `Background #${bgObj.id} (${bgObj.name})`;
      }

      let fontStack = "'Comic Sans MS', 'Comic Sans', cursive";
      if (appState.customGoogleFont) {
        fontStack = `'${appState.customGoogleFont}', sans-serif`;
      } else if (appState.language === 'ms') {
        fontStack = "'Comic Sans MS', 'Comic Sans', cursive";
      } else if (appState.language === 'en') {
        fontStack = "'Cooper Black', 'Rockwell Extra Bold', 'Arial Black', serif";
      } else if (appState.language === 'ta') {
        const tf = appState.tamilFont || 'Latha';
        fontStack = `'${tf}', 'Latha', 'Noto Sans Tamil', sans-serif`;
      }
      document.documentElement.style.setProperty('--app-font', fontStack);

      const dict = I18N[appState.language] || I18N.ms;
      document.querySelectorAll('[data-i18n]').forEach(el => {
        const key = el.getAttribute('data-i18n');
        if (dict[key]) el.textContent = dict[key];
      });

      const previewEl = document.getElementById('lang-preview-text');
      if (previewEl) {
        if (appState.language === 'ta') {
          previewEl.textContent = `மாணவர் தலைவர் அமைப்பிற்கு நல்வரவு! (${appState.tamilFont || 'Latha'})`;
        } else {
          previewEl.textContent = dict.previewText;
        }
      }

      ['ms', 'en', 'ta'].forEach(code => {
        const card = document.getElementById(`lang-card-${code}`);
        const chk = document.getElementById(`check-lang-${code}`);
        if (card && chk) {
          if (appState.language === code && !appState.customGoogleFont) {
            card.classList.add('border-blue-600', 'ring-2', 'ring-pink-300');
            chk.classList.remove('hidden');
          } else {
            card.classList.remove('border-blue-600', 'ring-2', 'ring-pink-300');
            chk.classList.add('hidden');
          }
        }
      });

      renderSettingsTamilFontsGrid();

      const titleText = appState.isPro4 ? 'PENGAWAS 4.0 PRO' : 'PENGAWAS 3.0';
      const loginTitle = document.getElementById('login-main-title');
      const navTitle = document.getElementById('nav-app-title');
      const loginBadge = document.getElementById('login-version-badge');
      const navProBadge = document.getElementById('nav-pro-badge');

      if (loginTitle) loginTitle.textContent = titleText;
      if (navTitle) navTitle.textContent = titleText;
      if (loginBadge) {
        loginBadge.textContent = appState.isPro4 ? 'SYSTEM v4.0 PRO EDITION' : 'SYSTEM v3.0 CLASSIC';
      }
      if (navProBadge) {
        if (appState.isPro4) navProBadge.classList.remove('hidden');
        else navProBadge.classList.add('hidden');
      }

      updatePro4UIState();
