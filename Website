        const parsed = JSON.parse(raw);
        const merged = Object.assign(buildDefaultState(), parsed);
        if (!merged.classMetrics) {
          merged.classMetrics = buildDefaultState().classMetrics;
        }
        return merged;
      } catch (e) {
        console.error('Error loading state:', e);
        return buildDefaultState();
      }
    }

    function saveState() {
      try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(appState));
