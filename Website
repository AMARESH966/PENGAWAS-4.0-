    async function playGoBeyondRingtone(manualTrigger = false) {
      if (!appState.startupSoundEnabled && !manualTrigger) return;
      if (ringtonePlaying) return;

      try {
        if (typeof Tone === 'undefined') return;
        await Tone.start();
        ringtonePlaying = true;

        const reverb = new Tone.Reverb({ decay: 2.2, wet: 0.35 }).toDestination();
        const bellSynth = new Tone.PolySynth(Tone.Synth, {
          oscillator: { type: 'sine' },
          envelope: { attack: 0.01, decay: 0.45, sustain: 0.15, release: 0.9 }
        }).connect(reverb);
        bellSynth.volume.value = -6;

        const chimeOvertones = new Tone.PolySynth(Tone.Synth, {
          oscillator: { type: 'triangle' },
          envelope: { attack: 0.005, decay: 0.25, sustain: 0.05, release: 0.5 }
        }).connect(reverb);
        chimeOvertones.volume.value = -12;

        const melody = [
          { time: 0.00, notes: ['E4', 'B4'], dur: '8n' },
          { time: 0.18, notes: ['F#4', 'C#5'], dur: '8n' },
          { time: 0.36, notes: ['G#4', 'E5'], dur: '4n' },
          { time: 0.62, notes: ['B4', 'F#5'], dur: '8n' },
          { time: 0.80, notes: ['C#5', 'G#5'], dur: '8n' },
          { time: 0.98, notes: ['E5', 'B5'], dur: '4n' },
          { time: 1.28, notes: ['D#5', 'F#5'], dur: '8n' },
          { time: 1.46, notes: ['B4', 'E5'], dur: '8n' },
          { time: 1.66, notes: ['G#4', 'E5', 'B5'], dur: '2n' }
        ];

        const now = Tone.now() + 0.03;
        melody.forEach(step => {
          bellSynth.triggerAttackRelease(step.notes, step.dur, now + step.time);
          chimeOvertones.triggerAttackRelease(step.notes, '16n', now + step.time);
        });

        if (manualTrigger) {
          showToast('♪ Go Beyond Traditional Ringtone', 'info');
        }

        setTimeout(() => {
          ringtonePlaying = false;
          bellSynth.dispose();
          chimeOvertones.dispose();
          reverb.dispose();
        }, 2600);
      } catch (err) {
        ringtonePlaying = false;
      }
    }

    function initStartupMusic() {
      updateStartupSoundButton();
      if (!appState.startupSoundEnabled) return;

      playGoBeyondRingtone(false);

      const unlockOnce = () => {
        if (!startupAutoPlayed && appState.startupSoundEnabled) {
          startupAutoPlayed = true;
          playGoBeyondRingtone(false);
        }
        window.removeEventListener('pointerdown', unlockOnce);
        window.removeEventListener('keydown', unlockOnce);
      };
      window.addEventListener('pointerdown', unlockOnce, { once: true });
      window.addEventListener('keydown', unlockOnce, { once: true });
    }

    window.addEventListener('DOMContentLoaded', () => {
      applyVisualSettings();
      renderAppScreens();
      initStartupMusic();
    });
